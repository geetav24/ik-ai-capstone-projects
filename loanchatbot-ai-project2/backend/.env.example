# -----------------------------------------------------------------------
# LoanInquiry AI — Project 2 environment variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All keys marked "same as Project 1" can be copied from
# loanflow-ai-project1/backend/.env
# -----------------------------------------------------------------------

# OpenAI — same as Project 1
OPENAI_API_KEY=

# Pinecone — same as Project 1
# The index must already be populated by running generate_policy.py in Project 1
PINECONE_API_KEY=
PINECONE_INDEX_NAME=loanflow-ai
EMBEDDING_MODEL=text-embedding-3-small

# Tavily — web search (free tier: https://tavily.com)
# Project 1 does NOT use Tavily — this is new for Project 2
TAVILY_API_KEY=

# SQLite database path — defaults to Project 1's DB if not set
# Only override if you want a separate DB for testing
# DB_PATH=/path/to/your/loanflow.db
